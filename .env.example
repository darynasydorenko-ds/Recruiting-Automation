# Copy this file to .env and fill in your tokens
# .env is gitignored — never commit your real tokens

# Asana Personal Access Token
# Get it from: https://app.asana.com/0/my-apps → Personal access tokens
ASANA_TOKEN=your_asana_personal_access_token_here

# Anthropic API Key
# Get it from: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Slack Bot Token (starts with xoxb-)
# Requires scopes: chat:write, channels:read, groups:read
# Get it from: https://api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
